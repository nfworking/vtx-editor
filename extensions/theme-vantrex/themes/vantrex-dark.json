	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#5f5f5f", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "variable.language", "support.type.primitive", "constant.language", "keyword.other.unit"],
			"settings": { "foreground": "#fafafa" }
		},
		{
			"scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "meta.delimiter", "punctuation.accessor"],
			"settings": { "foreground": "#8c8c8c" }
		},
		{
			"scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "markup.inline.raw"],
			"settings": { "foreground": "#8fcf9f" }
		},
		{
			"scope": ["string.regexp", "constant.character.escape", "punctuation.definition.template-expression", "keyword.other.template"],
			"settings": { "foreground": "#ffb224" }
		},
		{
			"scope": ["constant.numeric", "constant.other", "constant.character", "support.constant", "keyword.other.unit"],
			"settings": { "foreground": "#ffb224" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function", "meta.function-call"],
			"settings": { "foreground": "#ffffff" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.class", "support.type", "meta.type.annotation", "entity.name.type.interface"],
			"settings": { "foreground": "#ffffff" }
		},
		{
			"scope": ["variable", "meta.definition.variable", "variable.other", "variable.parameter", "meta.object-literal.key"],
			"settings": { "foreground": "#d9d9d9" }
		},
		{
			"scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property-name", "support.type.property-name", "entity.name.tag.yaml"],
			"settings": { "foreground": "#bdbdbd" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag", "entity.name.tag.css", "entity.name.tag.html"],
			"settings": { "foreground": "#fafafa" }
		},
		{
			"scope": ["entity.other.attribute-name", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "support.type.vendored.property-name"],
			"settings": { "foreground": "#ffffff" }
		},
		{
			"scope": ["support.type.property-name.css", "meta.property-name.css", "support.type.property-name.json"],
			"settings": { "foreground": "#bdbdbd" }
		},
		{
			"scope": ["support.constant.property-value.css", "meta.property-value.css", "constant.other.color"],
			"settings": { "foreground": "#ffb224" }
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name", "entity.name.section"],
			"settings": { "foreground": "#fafafa", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold", "foreground": "#ffffff" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link", "markup.link"],
			"settings": { "foreground": "#d4d4d4" }
		},
		{
			"scope": ["markup.inserted", "punctuation.definition.inserted"],
			"settings": { "foreground": "#46a758" }
		},
		{
			"scope": ["markup.deleted", "punctuation.definition.deleted"],
			"settings": { "foreground": "#e5484d" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#ff6b6b" }
		}
	],
	"semanticTokenColors": {
		"function": "#ffffff",
		"method": "#ffffff",
		"class": "#ffffff",
		"interface": "#ffffff",
		"type": "#ffffff",
		"typeParameter": "#ffffff",
		"enum": "#ffffff",
		"enumMember": "#ffb224",
		"namespace": "#ffffff",
		"property": "#bdbdbd",
		"variable": "#d9d9d9",
		"variable.readonly": "#ffb224",
		"parameter": "#d9d9d9",
		"macro": "#fafafa",
		"*.deprecated": { "fontStyle": "strikethrough" }
	}
}
