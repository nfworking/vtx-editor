	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#a0a0a0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"variable.language",
				"support.type.primitive",
				"constant.language",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.delimiter",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#737373"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#3f9a56"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape",
				"punctuation.definition.template-expression",
				"keyword.other.template"
			],
			"settings": {
				"foreground": "#b47500"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.other",
				"constant.character",
				"support.constant",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#b47500"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"variable.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#000000"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.class",
				"support.type",
				"meta.type.annotation",
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable",
				"variable.other",
				"variable.parameter",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#262626"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property",
				"meta.property-name",
				"support.type.property-name",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#424242"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag",
				"punctuation.definition.tag",
				"entity.name.tag.css",
				"entity.name.tag.html"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"support.type.vendored.property-name"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		},
		{
			"scope": [
				"support.type.property-name.css",
				"meta.property-name.css",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#424242"
			}
		},
		{
			"scope": [
				"support.constant.property-value.css",
				"meta.property-value.css",
				"constant.other.color"
			],
			"settings": {
				"foreground": "#b47500"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#0a0a0a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#000000"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"markup.link"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#2a6936"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#a71418"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#0a0a0a"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#000000",
		"method": "#000000",
		"class": "#0a0a0a",
		"interface": "#0a0a0a",
		"type": "#0a0a0a",
		"typeParameter": "#0a0a0a",
		"enum": "#0a0a0a",
		"enumMember": "#b47500",
		"namespace": "#0a0a0a",
		"property": "#424242",
		"variable": "#262626",
		"variable.readonly": "#b47500",
		"parameter": "#262626",
		"macro": "#0a0a0a",
		"*.deprecated": {
			"fontStyle": "strikethrough"
		}
	}
